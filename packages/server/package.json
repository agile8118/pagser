{
  "name": "@pagser/server",
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "private": true,
  "exports": "./index.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "seed": "./env.sh tsx ./src/database/seed.ts",
    "start": "./env.sh node ./dist/index.js",
    "build": "tsc -p .",
    "dev": "./env.sh tsx watch ./src/index.ts",
    "prod": "./env.sh pm2 start ecosystem.config.cjs",
    "test": "./env.sh DB_DATABASE=pagser_test NODE_ENV=test mocha",
    "test:seed": "./env.sh DB_DATABASE=pagser_test NODE_ENV=test tsx ./src/database/seed.ts",
    "test:watch": "./env.sh DB_DATABASE=pagser_test NODE_ENV=test mocha --watch",
    "test:coverage": "./env.sh DB_DATABASE=pagser_test NODE_ENV=test c8 mocha"
  },
  "c8": {
    "include": [
      "src/api/**/*.ts"
    ],
    "exclude": [
      "**/*.d.ts"
    ],
    "reporter": [
      "text",
      "html"
    ],
    "all": true
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1041.0",
    "@aws-sdk/client-ses": "^3.1042.0",
    "@aws-sdk/lib-storage": "^3.1041.0",
    "@pagser/common": "1.0.0",
    "cpeak": "^2.9.2",
    "pg": "^8.20.0",
    "sanitize-html": "^2.7.1",
    "sharp": "^0.34.5",
    "validator": "^13.7.0",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "^18.6.4",
    "@types/pg": "^8.20.0",
    "@types/sanitize-html": "^2.6.2",
    "@types/sharp": "^0.32.0",
    "@types/supertest": "^6.0.2",
    "@types/validator": "^13.7.5",
    "aws-sdk-client-mock": "^4.0.0",
    "c8": "^9.1.0",
    "mocha": "^10.4.0",
    "supertest": "^7.0.0",
    "swagger-ui-dist": "^5.32.5",
    "tsx": "^4.22.4",
    "typescript": "4.7.4"
  }
}
