# This is an example .env file for the server. You should copy this to .env and fill in the values as needed.

PORT='3080'
DOMAIN='http://localhost:3080'

TOKEN_SECRET='<random-at-least-32-characters>'
COOKIE_SECRET='<random-at-least-32-characters>'

# Regular database
DB_USER='postgres'
DB_HOST='localhost'
DB_DATABASE='pagser'
DB_PASSWORD=''
DB_PORT='5432'

# Used for Playwright testing (DB_TARGET=playwright), separate from the main database
DB_PLAYWRIGHT_USER='postgres'
DB_PLAYWRIGHT_HOST='localhost'
DB_PLAYWRIGHT_DATABASE='pagser'
DB_PLAYWRIGHT_PASSWORD=''
DB_PLAYWRIGHT_PORT='5433'

# Used for regular server testing (DB_TARGET=test), separate from the main database
DB_TEST_USER='postgres'
DB_TEST_HOST='localhost'
DB_TEST_DATABASE='pagser_test'
DB_TEST_PASSWORD=''
DB_TEST_PORT='5434'

# Change to your AWS region (used for S3 and SES)
AWS_REGION="us-east-1";

# Create an S3 bucket and put the name of your bucket. This is where uploaded images/files will be stored.
S3_BUCKET="<your-s3-bucket-name>";

# Set to true to skip sending emails (useful for development and testing)
SKIP_EMAIL=false

# Set these to use Cloudflare R2 instead of S3 (recommended, cheaper, and no egress fees):
# R2_ACCOUNT_ID="<your-cloudflare-account-id>"
# R2_ACCESS_KEY_ID="<r2-access-key-id>"
# R2_SECRET_ACCESS_KEY="<r2-secret-access-key>"
# R2_BUCKET="<your-r2-bucket-name>"
# R2_PUBLIC_URL="https://<your-public-r2-domain>"
