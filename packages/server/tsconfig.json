{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "strict": false,

    "declaration": true,
    "declarationMap": false,
    "sourceMap": true,
    "removeComments": true,

    "esModuleInterop": true,
    "types": ["node"],

    "outDir": "dist",
    "rootDir": "src",
    "skipLibCheck": true
  },
  "include": ["src"],
  "exclude": ["__tests__", "dist"]
}
